# ============================================================================
# OrionFlow — BACKEND production env (FastAPI on Fly.io / Render / Koyeb)
# Copy to your host's secret manager. Do NOT commit the filled-in version.
# ============================================================================

# --- App ---
ENVIRONMENT=production
DEBUG=false
APP_VERSION=0.3.0

# --- OrionFlow's own model (REQUIRED) -------------------------------------
# One remotely served endpoint backs BOTH the studio and the FreeCAD copilot.
# There is no default and it must not be a local address: 127.0.0.1 in a
# deployed secret points the container at itself and fails as "the model is
# unreachable", which sends you debugging the model instead of the address.
# create_modal_secret.py refuses to push a local address.
#
# Two adapters are served from this one endpoint. ORION_LLM_MODEL is the BASE
# adapter, because the agent loop and conversation need tool calling and
# ordinary prose; the fine-tuned `orionflow` adapter is trained to answer every
# input with a Blueprint and is selected per-call for geometry.
ORION_LLM_PROVIDER=vllm
ORION_LLM_MODEL=orionflow-base
ORION_LLM_BASE_URL=https://your-gpu-endpoint.example.com/v1
ORION_LLM_API_KEY=your_endpoint_key_here
ORION_LLM_FALLBACK_PROVIDER=
# Blueprints are long; the default token budget truncates them mid-JSON.
ORION_LLM_MAX_TOKENS=8192

# For local development only, in your own .env — never in a deployed secret:
#   ORION_LLM_BASE_URL=http://127.0.0.1:8100/v1

# --- Legacy OFL path (Groq) ------------------------------------------------
# The pre-fine-tune OFL endpoints. Not used by the studio.
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_key_here
LLM_MODEL=llama-3.3-70b-versatile
OFL_LLM_PROVIDER=groq
OFL_GROQ_MODEL=llama-3.3-70b-versatile

# --- CORS / frontend (your domain) ---
CORS_ORIGINS=https://orionflow.in,https://www.orionflow.in,https://app.orionflow.in
FRONTEND_URL=https://app.orionflow.in

# --- Database (Supabase — use the DIRECT connection, port 5432) ---
# Supabase: Project Settings -> Database -> Connection info
DB_HOST=db.YOUR_PROJECT_REF.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_supabase_db_password
DB_NAME=postgres
# NOTE: Supabase requires SSL. If asyncpg can't connect, see runbook step 4
#       (add ssl to the engine connect_args).

# --- Redis (Upstash free — or remove if not running Celery) ---
REDIS_HOST=your-instance.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_upstash_password
REDIS_DB=0

# --- Auth ---
# Generate once:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_long_random_string

# --- Email (Hostinger Starter Business Email) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hello@orionflow.in
SMTP_PASSWORD=your_mailbox_password
SMTP_FROM_EMAIL=hello@orionflow.in
SMTP_FROM_NAME=OrionFlow

# --- Limits ---
FREE_TIER_GENERATIONS=10
RATE_LIMIT_GENERATION=10/minute
LOG_LEVEL=INFO
LOG_FORMAT=json
